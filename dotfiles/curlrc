# ~/.curlrc — default curl options

# Show errors even when -s (silent) is used
--show-error

# Follow redirects
--location

# Retry up to 3 times on transient failures
--retry 3
--retry-delay 2
--retry-connrefused

# Reasonable timeouts
--connect-timeout 10
--max-time 30

# Use HTTP/2 where available
--http2
