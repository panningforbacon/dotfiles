#!/bin/zsh -f
# bin/provision: the entry point for every run (docs/architecture.md §3, §4).
#
#   bin/provision [--check] [--upgrade] [--help]
#
# Error handling (ADR-0002, DEC-19): no ERR_EXIT. Every failure is a return
# code that the caller reads, and the code that detects a failure logs the
# FAIL line naming it. An exit-on-error option would end the run with no
# line and no summary (FR-15.1, FR-15.3).

setopt NO_UNSET PIPE_FAIL

# idiom: ${0:A:h:h}. :A makes the script's path absolute and resolves
# symlinks; each :h drops the last path component, like dirname.
# The checkout that holds this script is the one that runs (CR-6), whatever
# the caller's environment says.
typeset -g DOTFILES_DIR=${0:A:h:h}

typeset -g CHECK_MODE=0 UPGRADE_MODE=0

# The stage order is this array, never file-name order (architecture §4).
typeset -ga PROVISION_STAGES=(
  preflight
  defaults
)

# Set by the stage runner for the summary; empty means every stage ran.
typeset -g _PROVISION_STOPPED_AT=''

source $DOTFILES_DIR/lib/log.zsh
source $DOTFILES_DIR/lib/converge.zsh

provision_main() {
  emulate -L zsh; setopt NO_UNSET PIPE_FAIL

  local arg
  for arg in "$@"; do
    case $arg in
      (--check)   CHECK_MODE=1 ;;
      (--upgrade) UPGRADE_MODE=1 ;;
      (--help)    _provision_usage 1; return 0 ;;
      (*)
        log FAIL "$arg" 'unknown option — see the usage below'
        _provision_usage 2
        return 64
        ;;
    esac
  done

  local -i stages_rc=0 crashed=0
  # idiom: { try } always { finally }. The always block runs however the try
  # block ends, including a zsh error such as an unset parameter, which
  # aborts everything up to the top level and cannot be read as a status.
  {
    _provision_load_modules && _provision_run_stages
    stages_rc=$?
  } always {
    if (( TRY_BLOCK_ERROR )); then
      crashed=1
      # Resetting it tells zsh the error is handled, so the run can still
      # end with a summary and its own exit code.
      TRY_BLOCK_ERROR=0
      LOG_MODULE=provision
      log FAIL provision 'stopped by the zsh error above — this is a bug in the script, not in your Mac'
    fi
    _provision_summary
  }

  _provision_total failed
  if (( stages_rc == 2 && ! crashed )); then
    return 2
  elif (( stages_rc != 0 || crashed || REPLY > 0 )); then
    return 1
  fi
  return 0
}

# --- private -----------------------------------------------------------------

# _provision_usage <fd>. Usage is the one text that does not go through log:
# it is help, not run output (architecture §7).
_provision_usage() {
  emulate -L zsh; setopt NO_UNSET PIPE_FAIL
  print -r -u $1 -- "\
usage: bin/provision [--check] [--upgrade] [--help]

Converges this Mac to the state declared in $DOTFILES_DIR.

  (no option)  Apply every difference, then verify it.
  --check      Run every check and change nothing. No manual stops.
               Differences are reported as DIFF lines.
  --upgrade    Also upgrade mise runtimes to the latest patch within each
               declared version. Affects runtimes only: Homebrew packages
               upgrade on every run, with or without this option.
  --help       Print this text.

Exit codes: 0 no failure, 1 at least one FAIL, 2 act and re-run, 64 usage error."
}

# Loads every module before any stage runs, so a missing or broken module
# stops the run before the first change instead of halfway through.
_provision_load_modules() {
  emulate -L zsh; setopt NO_UNSET PIPE_FAIL
  local stage file
  for stage in $PROVISION_STAGES; do
    file=$DOTFILES_DIR/modules/$stage.zsh
    if [[ ! -r $file ]]; then
      log FAIL "$stage" "modules/$stage.zsh is missing — restore it (git status shows what changed), then re-run"
      return 1
    fi
    if ! source $file; then
      log FAIL "$stage" "modules/$stage.zsh failed to load — fix the error above, then re-run"
      return 1
    fi
    if (( ! $+functions[mod_${stage}_run] )); then
      log FAIL "$stage" "modules/$stage.zsh does not define mod_${stage}_run — define it, then re-run"
      return 1
    fi
  done
}

# Runs the stages in order and returns the first non-zero stage status,
# reduced to 1 (failed) or 2 (bail-out).
_provision_run_stages() {
  emulate -L zsh; setopt NO_UNSET PIPE_FAIL
  local stage
  local -i rc failed_before
  for stage in $PROVISION_STAGES; do
    _provision_total failed; failed_before=$REPLY

    # Read through `if`, so $? in the else branch is the stage's own status.
    if mod_${stage}_run; then
      LOG_MODULE=provision
      continue
    else
      rc=$?
    fi
    LOG_MODULE=provision
    _PROVISION_STOPPED_AT=$stage

    if (( rc == 2 )); then
      return 2
    fi
    _provision_total failed
    if (( rc != 1 )); then
      log FAIL "$stage" "mod_${stage}_run returned $rc, but a module returns 0, 1 or 2 — this is a bug in modules/$stage.zsh"
    elif (( REPLY == failed_before )); then
      # Exit code 1 means "at least one FAIL" (architecture §3), so a silent
      # failure gets its line here.
      log FAIL "$stage" "mod_${stage}_run returned 1 without a FAIL line — this is a bug in modules/$stage.zsh"
    fi
    return 1
  done
}

# _provision_total <counter>: sums one counter over every module, into REPLY.
_provision_total() {
  emulate -L zsh; setopt NO_UNSET PIPE_FAIL
  local key
  local -i total=0
  # idiom: ${(k)assoc} expands to the keys of an associative array.
  for key in ${(k)LOG_COUNTS}; do
    # ${key##*:} strips the longest prefix ending in ':', leaving the counter;
    # module names such as defaults.dock contain dots, never colons.
    [[ ${key##*:} == $1 ]] && (( total += LOG_COUNTS[$key] ))
  done
  REPLY=$total
}

_provision_summary() {
  emulate -L zsh; setopt NO_UNSET PIPE_FAIL
  _provision_total changed;      local -i changed=$REPLY
  _provision_total ok;           local -i ok=$REPLY
  _provision_total failed;       local -i failed=$REPLY
  _provision_total would_change; local -i would_change=$REPLY

  LOG_MODULE=summary
  if (( CHECK_MODE )); then
    log NOTE check "$would_change would change · $ok ok · $failed failed"
  else
    log NOTE run "$changed changed · $ok ok · $failed failed"
  fi
  if [[ -n $_PROVISION_STOPPED_AT ]]; then
    log NOTE '' "stopped at $_PROVISION_STOPPED_AT — fix what it reported, then re-run"
  fi
}

provision_main "$@"
