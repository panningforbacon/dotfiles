# Per-machine settings.
# 
# Copy to .env, or leave .env missing and the run prompts once for every missing or 
# empty key. Never put secrets here.

# Name for this Mac, applied to computer name, local hostname, and hostname.
COMPUTER_NAME=

# Author name for git commits on this machine.
GIT_AUTHOR_NAME=

# Author email for git commits; use GitHub's no-reply address (ID+USERNAME@users.noreply.github.com).
GIT_AUTHOR_EMAIL=